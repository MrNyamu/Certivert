		{
			"name": "Issue Certificate",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('certId');",
							"    pm.expect(jsonData).to.have.property('ipfsCid');",
							"    pm.expect(jsonData).to.have.property('proposeTxId');",
							"    pm.expect(jsonData).to.have.property('approveTxId');",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData.status).to.eql('issued');",
							"});",
							"",
							"pm.test(\"Certificate ID is valid hash\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.certId).to.match(/^[a-f0-9]{64}$/);",
							"});",
							"",
							"// Save certId for other requests",
							"pm.test(\"Save certificate ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.environment.set('certId', jsonData.certId);",
							"    console.log('Certificate ID saved:', jsonData.certId);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
