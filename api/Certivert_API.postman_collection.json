{
	"info": {
		"_postman_id": "certivert-api-collection",
		"name": "Certivert API",
		"description": "Complete API collection for the Certivert blockchain certificate verification system. Supports both simnet (development) and network (production) modes.\n\n## Environment Variables\n- `baseUrl`: API base URL (default: http://localhost:3001)\n- `certId`: Certificate ID for testing (will be set automatically after issuing a certificate)\n\n## Usage\n1. Set environment to 'Certivert Local' or create your own\n2. Issue a certificate to get a real certId\n3. Use that certId for verification and revocation tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has status field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData.status).to.eql('OK');",
							"});",
							"",
							"pm.test(\"Response has network field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('network');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
