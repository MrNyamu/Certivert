		{
			"name": "Revoke Certificate",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('certId');",
							"    pm.expect(jsonData).to.have.property('txId');",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('revokedBy');",
							"    pm.expect(jsonData.status).to.eql('revoked');",
							"});",
							"",
							"pm.test(\"Transaction ID is valid\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.txId).to.include('simnet_revoke_');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
