# Certivert API Configuration Template
# Copy this file to .env and update with your actual values

# Stacks Network Configuration
STACKS_NETWORK=devnet
STACKS_API_URL=http://localhost:3999
CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS_HERE
CONTRACT_NAME_ROLES=role-registry
CONTRACT_NAME_CERTS=certificate-store

# IPFS Configuration
IPFS_API_URL=http://127.0.0.1:5001

# API Configuration
API_PORT=4000

# Security Configuration
# IMPORTANT: Generate a new 32-byte (64 character) hex key for production
# Example: openssl rand -hex 32
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# Private Keys (Use devnet keys for development only)
# Generate new keys for production: clarinet accounts new
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY_HERE
SIGNER_2_PRIVATE_KEY=YOUR_SIGNER_2_PRIVATE_KEY_HERE

# Optional: Node.js Environment
NODE_ENV=development